{
  "name": "openbot",
  "version": "0.1.0",
  "description": "Use any model in Grok Bot. Install on the Computer, pick a provider, keep chatting in the app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openbot": "src/cli.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"recovery/hooks/test_*.mjs\"",
    "test:install-result": "node --experimental-strip-types --test src/install-result.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "start": "node --experimental-strip-types src/cli.ts",
    "start:ui": "node --experimental-strip-types src/ui/server.ts",
    "build": "vite build",
    "dev": "vite",
    "export:shareable": "node scripts/export-shareable.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickkostik/openbot-community.git"
  },
  "bugs": {
    "url": "https://github.com/nickkostik/openbot-community/issues"
  },
  "homepage": "https://github.com/nickkostik/openbot-community#readme",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^1.39.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "eslint-scope": "9.1.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
